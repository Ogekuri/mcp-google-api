{
  "name": "mcp-google-api",
  "version": "0.26.8",
  "description": "Google API MCP server — 18 Google Maps tools for AI agents: geocoding, Places API (New) search with server-side filters, directions, distance matrix and more, via stdio or Streamable HTTP",
  "type": "module",
  "bin": {
    "mcp-google-api": "bin/mcp-google-api.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/*.tgz",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.unit.test.ts",
    "test:e2e": "tsx tests/smoke.test.ts",
    "check:publish-version": "node tools/check-publish-version.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check:publish-version && npm run build",
    "prepare": "node tools/prepare-dist.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "google",
    "google-maps",
    "maps",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "places",
    "places-api-new",
    "geocoding",
    "directions"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ogekuri/mcp-google-api.git"
  },
  "bugs": {
    "url": "https://github.com/Ogekuri/mcp-google-api/issues"
  },
  "homepage": "https://github.com/Ogekuri/mcp-google-api#readme",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@googlemaps/places": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^4.21.2",
    "yargs": "^17.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.33",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
